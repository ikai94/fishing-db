{
  "name": "fishing-db",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm db:generate && pnpm --parallel --filter @fishing-db/web --filter @fishing-db/api run dev",
    "dev:web": "pnpm --filter @fishing-db/web run dev",
    "dev:api": "pnpm db:generate && pnpm --filter @fishing-db/api run dev",
    "build": "pnpm db:generate && pnpm -r --if-present run build",
    "lint": "pnpm db:generate && pnpm -r --if-present run lint",
    "typecheck": "pnpm db:generate && pnpm -r --if-present run typecheck",
    "test": "pnpm db:generate && pnpm -r --if-present run test",
    "test:e2e": "pnpm db:generate && pnpm --filter @fishing-db/api run test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:state": "node scripts/verify-state.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @fishing-db/api run prisma:generate",
    "db:migrate:dev": "pnpm --filter @fishing-db/api run prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @fishing-db/api run prisma:migrate:deploy",
    "db:seed": "pnpm --filter @fishing-db/api run prisma:seed",
    "db:seed:catalog": "pnpm --filter @fishing-db/api run db:seed:catalog",
    "db:audit:catch-reports": "pnpm --filter @fishing-db/api run db:audit:catch-reports",
    "db:audit:fish-catalog": "pnpm --filter @fishing-db/api run db:audit:fish-catalog",
    "db:audit:fish-catalog:check": "pnpm --filter @fishing-db/api run db:audit:fish-catalog:check",
    "db:audit:fish-catalog:manual-review": "pnpm --filter @fishing-db/api run db:audit:fish-catalog:manual-review",
    "db:audit:fish-catalog:manual-review:check": "pnpm --filter @fishing-db/api run db:audit:fish-catalog:manual-review:check",
    "db:audit:fish-images": "pnpm --filter @fishing-db/api run db:audit:fish-images",
    "db:audit:fish-images:check": "pnpm --filter @fishing-db/api run db:audit:fish-images:check",
    "db:build:fish-image-release": "pnpm --filter @fishing-db/api run db:build:fish-image-release",
    "db:materialize:fish-images": "pnpm --filter @fishing-db/api run db:materialize:fish-images",
    "db:reconcile:fish-catalog:dry-run": "pnpm --filter @fishing-db/api run db:reconcile:fish-catalog:dry-run",
    "db:reconcile:fish-catalog:apply": "pnpm --filter @fishing-db/api run db:reconcile:fish-catalog:apply",
    "db:reconcile:fishing-base-fish": "pnpm --filter @fishing-db/api run db:reconcile:fishing-base-fish",
    "forum:scan": "pnpm --filter @fishing-db/api run forum:scan",
    "forum:stage": "pnpm db:generate && pnpm --filter @fishing-db/api run forum:stage",
    "forum:recover-fish-catalog": "pnpm db:generate && pnpm --filter @fishing-db/api run forum:recover-fish-catalog",
    "forum:audit": "pnpm --filter @fishing-db/api run forum:audit",
    "forum:review": "pnpm --filter @fishing-db/api run forum:review",
    "forum:import-complete": "pnpm db:generate && pnpm --filter @fishing-db/api run forum:import-complete",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "db:test:down": "docker compose --profile test stop postgres-test",
    "db:test:logs": "docker compose --profile test logs -f postgres-test",
    "db:studio": "pnpm --filter @fishing-db/api run prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}

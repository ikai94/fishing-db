{
  "name": "@fishing-db/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "test:e2e": "tsx --test --test-concurrency=1 \"test/**/*.spec.ts\" \"test/**/*.e2e-spec.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:seed:catalog": "tsx src/prisma/seed-catalog.ts",
    "db:audit:catch-reports": "tsx src/prisma/audit-catch-reports.ts",
    "db:audit:fish-catalog": "tsx src/prisma/generate-fish-catalog-audit.ts",
    "db:audit:fish-catalog:check": "tsx src/prisma/generate-fish-catalog-audit.ts --check",
    "db:audit:fish-catalog:manual-review": "tsx src/prisma/generate-fish-catalog-manual-review.ts",
    "db:audit:fish-catalog:manual-review:check": "tsx src/prisma/generate-fish-catalog-manual-review.ts --check",
    "db:reconcile:fish-catalog:dry-run": "tsx src/prisma/dry-run-fish-catalog-reconciliation.ts",
    "db:reconcile:fish-catalog:apply": "tsx src/prisma/apply-fish-catalog-reconciliation.ts",
    "db:reconcile:fishing-base-fish": "tsx src/prisma/reconcile-fishing-base-fish.ts",
    "forum:scan": "tsx src/forum-import/cli.ts scan",
    "forum:stage": "tsx src/forum-import/cli.ts stage",
    "forum:audit": "tsx src/forum-import/cli.ts audit",
    "forum:review": "tsx src/forum-import/cli.ts review",
    "forum:import-complete": "tsx src/forum-import/cli.ts import-complete",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cheerio": "1.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "robots-parser": "3.0.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}

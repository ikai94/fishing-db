generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BaitType {
  BAIT
  LURE
}

enum FishingNote {
  MIDWATER
  FROM_BOTTOM
  SURFACE
}

enum FishingMethod {
  BAIT_FISHING
  SPINNING
}

enum SpinningSize {
  SMALL
  MEDIUM
  LARGE
}

enum SpinningSpeed {
  SLOW
  MEDIUM
  FAST
}

enum ActivityEventType {
  CATCH_REPORT_CREATED
  CATCH_REPORT_BATCH_CREATED
  CATCH_REPORT_UPDATED
  CATCH_REPORT_DELETED
  CATALOG_ITEM_CREATED
  CATALOG_ITEM_UPDATED
  FISHING_BASE_FISH_ADDED
  FISHING_BASE_FISH_UPDATED
  FISHING_BASE_FISH_REMOVED
}

enum ActivitySubjectType {
  CATCH_REPORT
  CATCH_REPORT_BATCH
  FISHING_BASE
  LOCATION
  FISH
  BAIT
  FISHING_BASE_FISH
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique @db.VarChar(254)
  nickname           String          @db.VarChar(32)
  nicknameNormalized String          @unique @db.VarChar(32)
  passwordHash       String          @db.VarChar(255)
  role               UserRole        @default(USER)
  isBanned           Boolean         @default(false)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  catchReports       CatchReport[]
  activityEvents     ActivityEvent[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FishingBase {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(128)
  nameNormalized String            @unique @db.VarChar(128)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  locations      Location[]
  fishLinks      FishingBaseFish[]
}

model Location {
  id             String        @id @default(uuid()) @db.Uuid
  fishingBaseId  String        @db.Uuid
  number         Int
  name           String        @db.VarChar(128)
  nameNormalized String        @db.VarChar(128)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  fishingBase    FishingBase   @relation(fields: [fishingBaseId], references: [id], onDelete: Restrict)
  catchReports   CatchReport[]

  @@unique([fishingBaseId, number])
  @@unique([fishingBaseId, nameNormalized])
}

model Fish {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @db.VarChar(128)
  nameNormalized       String            @unique @db.VarChar(128)
  forumTopicId         String?           @unique @db.VarChar(32)
  officialFishImageKey Int?              @unique
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  fishingBaseLinks     FishingBaseFish[]
  catchReports         CatchReport[]
}

model Bait {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(128)
  nameNormalized String        @unique @db.VarChar(128)
  type           BaitType
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  catchReports   CatchReport[]
}

model FishingBaseFish {
  fishingBaseId  String      @db.Uuid
  fishId         String      @db.Uuid
  minWeightGrams Int?
  maxWeightGrams Int?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  fishingBase    FishingBase @relation(fields: [fishingBaseId], references: [id], onDelete: Restrict)
  fish           Fish        @relation(fields: [fishId], references: [id], onDelete: Restrict)

  @@id([fishingBaseId, fishId])
  @@index([fishId])
}

model ScreenAnchor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(128)
  nameNormalized String   @unique @db.VarChar(128)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model CatchReport {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  contributorKey  String         @db.VarChar(255)
  importKey       String?        @unique @db.VarChar(255)
  locationId      String         @db.Uuid
  fishId          String         @db.Uuid
  baitId          String         @db.Uuid
  weightGrams     Int
  fishingMethod   FishingMethod
  holeDepthCm     Int?
  spotPositionRaw String?        @db.VarChar(1000)
  fishingNote     FishingNote?
  spinningSize    SpinningSize?
  spinningSpeed   SpinningSpeed?
  userNoteRaw     String?        @db.VarChar(1000)
  rawSourceText   String?        @db.Text
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  location        Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fish            Fish           @relation(fields: [fishId], references: [id], onDelete: Restrict)
  bait            Bait           @relation(fields: [baitId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model ActivityEvent {
  id                    BigInt              @id @default(autoincrement())
  type                  ActivityEventType
  subjectType           ActivitySubjectType
  subjectKey            String              @db.VarChar(80)
  actorUserId           String              @db.Uuid
  actorNicknameSnapshot String              @db.VarChar(32)
  actorRoleSnapshot     UserRole
  payloadVersion        Int                 @default(1) @db.SmallInt
  payload               Json                @db.JsonB
  occurredAt            DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  actor                 User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectKey, id(sort: Desc)])
}

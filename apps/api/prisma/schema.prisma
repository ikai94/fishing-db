generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BaitType {
  BAIT
  LURE
}

enum FishingNote {
  MIDWATER
  FROM_BOTTOM
  SURFACE
}

enum FishingMethod {
  BAIT_FISHING
  SPINNING
}

enum SpinningSize {
  SMALL
  MEDIUM
  LARGE
}

enum SpinningSpeed {
  SLOW
  MEDIUM
  FAST
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique @db.VarChar(254)
  nickname           String        @db.VarChar(32)
  nicknameNormalized String        @unique @db.VarChar(32)
  passwordHash       String        @db.VarChar(255)
  role               UserRole      @default(USER)
  isBanned           Boolean       @default(false)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  catchReports       CatchReport[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FishingBase {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(128)
  nameNormalized String            @unique @db.VarChar(128)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  locations      Location[]
  fishLinks      FishingBaseFish[]
}

model Location {
  id             String        @id @default(uuid()) @db.Uuid
  fishingBaseId  String        @db.Uuid
  number         Int
  name           String        @db.VarChar(128)
  nameNormalized String        @db.VarChar(128)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  fishingBase    FishingBase   @relation(fields: [fishingBaseId], references: [id], onDelete: Restrict)
  catchReports   CatchReport[]

  @@unique([fishingBaseId, number])
  @@unique([fishingBaseId, nameNormalized])
}

model Fish {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @db.VarChar(128)
  nameNormalized       String            @unique @db.VarChar(128)
  forumTopicId         String?           @unique @db.VarChar(32)
  officialFishImageKey Int?              @unique
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  fishingBaseLinks     FishingBaseFish[]
  catchReports         CatchReport[]
}

model Bait {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(128)
  nameNormalized String        @unique @db.VarChar(128)
  type           BaitType
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  catchReports   CatchReport[]
}

model FishingBaseFish {
  fishingBaseId String      @db.Uuid
  fishId        String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  fishingBase   FishingBase @relation(fields: [fishingBaseId], references: [id], onDelete: Restrict)
  fish          Fish        @relation(fields: [fishId], references: [id], onDelete: Restrict)

  @@id([fishingBaseId, fishId])
  @@index([fishId])
}

model ScreenAnchor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(128)
  nameNormalized String   @unique @db.VarChar(128)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model CatchReport {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  contributorKey  String         @db.VarChar(255)
  importKey       String?        @unique @db.VarChar(255)
  locationId      String         @db.Uuid
  fishId          String         @db.Uuid
  baitId          String         @db.Uuid
  weightGrams     Int
  fishingMethod   FishingMethod
  holeDepthCm     Int?
  spotPositionRaw String?        @db.VarChar(1000)
  fishingNote     FishingNote?
  spinningSize    SpinningSize?
  spinningSpeed   SpinningSpeed?
  userNoteRaw     String?        @db.VarChar(1000)
  rawSourceText   String?        @db.Text
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  location        Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fish            Fish           @relation(fields: [fishId], references: [id], onDelete: Restrict)
  bait            Bait           @relation(fields: [baitId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

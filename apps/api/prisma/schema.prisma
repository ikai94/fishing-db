generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BaitType {
  BAIT
  LURE
}

enum SpotLandmark {
  ROD
  NOTEBOOK
  BACKPACK
  REEL
  CHAT
  TACKLE
}

enum FishingNote {
  MIDWATER
  FROM_BOTTOM
  SURFACE
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique @db.VarChar(254)
  nickname           String        @db.VarChar(32)
  nicknameNormalized String        @unique @db.VarChar(32)
  passwordHash       String        @db.VarChar(255)
  role               UserRole      @default(USER)
  isBanned           Boolean       @default(false)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  catchReports       CatchReport[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FishingBase {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(128)
  nameNormalized String     @unique @db.VarChar(128)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  locations      Location[]
}

model Location {
  id             String         @id @default(uuid()) @db.Uuid
  fishingBaseId  String         @db.Uuid
  number         Int
  name           String         @db.VarChar(128)
  nameNormalized String         @db.VarChar(128)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  fishingBase    FishingBase    @relation(fields: [fishingBaseId], references: [id], onDelete: Restrict)
  fishLinks      LocationFish[]
  catchReports   CatchReport[]

  @@unique([fishingBaseId, number])
  @@unique([fishingBaseId, nameNormalized])
}

model Fish {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(128)
  nameNormalized String         @unique @db.VarChar(128)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  locationLinks  LocationFish[]
  catchReports   CatchReport[]
}

model Bait {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(128)
  nameNormalized String        @unique @db.VarChar(128)
  type           BaitType
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  catchReports   CatchReport[]
}

model LocationFish {
  locationId String   @db.Uuid
  fishId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fish       Fish     @relation(fields: [fishId], references: [id], onDelete: Restrict)

  @@id([locationId, fishId])
  @@index([fishId])
}

model CatchReport {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  locationId   String        @db.Uuid
  fishId       String        @db.Uuid
  baitId       String        @db.Uuid
  weightGrams  Int
  holeDepthCm  Int?
  spotLandmark SpotLandmark?
  fishingNote  FishingNote?
  userNoteRaw  String?       @db.VarChar(1000)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fish         Fish          @relation(fields: [fishId], references: [id], onDelete: Restrict)
  bait         Bait          @relation(fields: [baitId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fishing:fishing_dev_password@localhost:5432/fishing_db
WEB_ORIGIN=http://localhost:3000
AUTH_EMAIL_DELIVERY_MODE=console
# Development-only key. Generate a unique 32-byte base64url value for production.
AUTH_EMAIL_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# SMTP mode additionally requires:
# EMAIL_FROM=Fishing Database <no-reply@example.ru>
# SMTP_URL=smtp://user:password@smtp.example.ru:587
FISH_IMAGE_DELIVERY_MODE=disabled
# For the approved local release, set mode=local and use an absolute path or `.local/fish-images`.
# FISH_IMAGE_STORAGE_ROOT=.local/fish-images
BAIT_IMAGE_DELIVERY_MODE=disabled
# For the approved local release, set mode=local and use an absolute path or `.local/bait-images`.
# BAIT_IMAGE_STORAGE_ROOT=.local/bait-images

# Used only when `pnpm db:seed` is invoked explicitly.
ADMIN_EMAIL=
ADMIN_NICKNAME=
ADMIN_PASSWORD=
